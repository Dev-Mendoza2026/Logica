Algoritmo "Exercício de Vetor"
// Autor(a)    : Alexander Mendoza
// Data atual  : 29/10/2026
Var

   i : inteiro
   Nota : Vetor [1..5] de Real
   Soma, Media : Real

Inicio

   Para i de 1 ate 5 faca
   Escreva (" Digite a ", i, " ° Nota : ")
   Leia ( Nota [i] )
   Fimpara
   
   Escreval (" Nota 1 : ", Nota [1])
   Escreval (" Nota 2 : ", Nota [2])
   Escreval (" Nota 3 : ", Nota [3])
   Escreval (" Nota 4 : ", Nota [4])
   Escreval (" Nota 5 : ", Nota [5])
   
   Soma <- Nota[1] + Nota[2] + Nota[3] + Nota[4] + Nota[5]
   Media <- Soma /5
   
   Escreval (" A média do Aluno é : ", Media:1:2)
   
   
   

Fimalgoritmo